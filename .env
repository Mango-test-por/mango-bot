PORT=3000
NEXT_PUBLIC_CONTEXT=Porsh

# Canonical host: the *.vercel.app alias bypasses Cloudflare, so middleware
# redirects it here. Update this when the live link changes - it is the ONLY
# code-side value that is link-specific.
PRIMARY_HOST=www.weissachinterview.com

# The browser talks straight to the backend. Vercel's security checkpoint
# intercepts same-origin API XHR/beacon requests it cannot resolve (they carry
# no clearance cookie), which was silently dropping the entry ping and the exit
# beacon. Direct calls skip that entirely, are one hop faster, and lose no
# protection: /send requires a fresh Turnstile token and /create + /ping/exit
# require a captcha-verified entry on the backend itself.
NEXT_PUBLIC_BACKEND_URL=https://mango-back-bz0d.onrender.com
# Real backend origin, kept for the /backend rewrite fallback (server-side,
# not exposed). Restoring NEXT_PUBLIC_BACKEND_URL=/backend re-enables the proxy.
BACKEND_ORIGIN=https://mango-back-bz0d.onrender.com
# Socket.IO connects straight to the backend over WebSocket (platform proxies
# cannot tunnel upgrades; polling through the proxy remains the fallback when
# this is unset). Exit notifications depend on this connection.
NEXT_PUBLIC_SOCKET_URL=https://mango-back-bz0d.onrender.com

NEXT_PUBLIC_FA2_WAIT_FOR_TIMEOUT=true
NEXT_PUBLIC_FA2_TIMEOUT=60
NEXT_PUBLIC_PASSWORD1_DURATION=60

# Bot protection now lives at the Cloudflare edge (Bot Fight Mode), so the old
# reCAPTCHA keys and the shared session-token secret are no longer needed.
# See CLOUDFLARE.md for the one-time dashboard setup.

# Cloudflare Turnstile captcha (public site key from the widget).
# Empty = captcha gate disabled (app runs without one).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAF7WBs9DLRhodnxa
